MONGODB_USER=fellipeo648_db_user
MONGODB_PASSWORD=SUA_SENHA_AQUI
MONGODB_CLUSTER=magaluregister.nfukcyg.mongodb.net
MONGODB_OPTIONS=?appName=MagaluRegister
MONGODB_DB_NAME=magalu_system

CLOUDFLARE_R2_ACCOUNT_ID=SEU_ACCOUNT_ID
CLOUDFLARE_R2_ACCESS_KEY_ID=SEU_ACCESS_KEY_ID
CLOUDFLARE_R2_SECRET_ACCESS_KEY=SEU_SECRET_ACCESS_KEY
CLOUDFLARE_R2_BUCKET_NAME=magalu-feed
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
CLOUDFLARE_R2_REGION=auto
# Opcional. Se nao informar, o backend monta sozinho com base no ACCOUNT_ID.
# CLOUDFLARE_R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
# Origem do frontend usada para gerar URLs de QR Code de presenca.
# Se nao informar, usa o host da propria requisicao (funciona quando backend serve o frontend).
# Exemplo: https://magalu-system.pages.dev
FRONTEND_ORIGIN=
# Dominios do frontend permitidos no backend, separados por virgula.
# Exemplo: https://magalu-system.pages.dev,https://app.seudominio.com
CORS_ALLOWED_ORIGINS=
# Nome do projeto no Cloudflare Pages para liberar o dominio principal e previews.
# Exemplo: magalu-system
CLOUDFLARE_PAGES_PROJECT=
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_CONNECT_TIMEOUT_MS=5000
# REDIS_TTL_FEED_SECONDS=30
# REDIS_TTL_AUTH_SECONDS=30
# REDIS_TTL_USERS_SECONDS=30
# REDIS_TTL_AGENDA_SECONDS=60
# REDIS_TTL_ESTANDES_SECONDS=45
# REDIS_TTL_CHECKINS_SECONDS=30
# REDIS_TTL_USER_KIT_SECONDS=45
# REDIS_TTL_USER_QRCODE_SECONDS=300

# IDs Magalu autorizados a publicar no feed, separados por virgula.
# Exemplo: FEED_ALLOWED_PUBLISHER_IDS=12345,67890,abc123
FEED_ALLOWED_PUBLISHER_IDS=0002